{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "supplier-route": {
        "ClusterId": "supplier-cluster",
        "Match": {
          "Path": "/api/suppliers/{**catch-all}"
        }
      },
      "compliance-route": {
        "ClusterId": "compliance-cluster",
        "Match": {
          "Path": "/api/compliance/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "supplier-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "compliance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}
